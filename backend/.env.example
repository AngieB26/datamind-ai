# Application database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=datamind_db
DB_USER=datamind_reader
DB_PASSWORD=your_local_db_password

# Dataset importation
DATASET_IMPORT_DB_USER=datamind_importer
DATASET_IMPORT_DB_PASSWORD=your_dataset_import_password
DATASET_READ_DB_USER=datamind_reader
DATASET_ROLE_SECRET=replace_with_a_64_character_random_secret

# Authentication
AUTH_SECRET_KEY=replace_with_a_secure_random_secret
AUTH_TOKEN_EXPIRE_MINUTES=30
AUTH_ALLOW_REGISTRATION=true

# History database
HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=datamind_db
HISTORY_DB_USER=datamind_history
HISTORY_DB_PASSWORD=your_local_history_password

# Microsoft Foundry
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_MODEL=gpt-4.1-mini
